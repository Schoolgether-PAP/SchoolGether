@page "/"
@using SchoolGether.Web.Public
<PageTitle>@UiMessages.Get("Brand")</PageTitle>
@if (View is "entrar" or "area")
{
    <IdentityPage />
}
else
{
    <PublicLanding ShowRegistration="@(View == "aderir")" PlanId="@Plan" />
}
@code {
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedView { get; set; }
    [SupplyParameterFromQuery(Name = "plan")] public string? Plan { get; set; }
    private string View => RequestedView is "entrar" or "area" or "aderir" ? RequestedView : "";
}
