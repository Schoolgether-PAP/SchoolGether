@using SchoolGether.ApiClient.Academic
@using SchoolGether.Contracts.Academic
@inherits EnrolmentView
@inject AcademicEnrolmentApiClient Api

@if (Active) {
<section class="student-picker" aria-label="@T("EnrolmentChoose")" aria-busy="@(Busy ? "true" : "false")">
    <h3>@T("EnrolmentChoose")</h3><p>@T("EnrolmentPickerHelp")</p>
    <div><label for="student-search">@T("EnrolmentSearch")</label><div class="search"><input id="student-search" maxlength="150" @bind="search" disabled="@(Busy || Disabled)" @onkeydown="SearchKeyAsync" /><button type="button" disabled="@(Busy || Disabled)" @onclick="SearchAsync">@T("CourseSearchAction")</button></div></div>
    @if (Error is not null) { <p role="alert">@Error</p><button type="button" disabled="@(Busy || Disabled)" @onclick="() => LoadAsync(retryPage)">@T("Retry")</button> }
    @if (Busy) { <p role="status">@T("Loading")</p> }
    else if (students is not null) {
        @if (students.Items.Count == 0) { <p>@T("EnrolmentPickerEmpty")</p> }
        @foreach (var item in students.Items) {
            <label class="student" @key="item.StudentId"><input type="radio" name="student" value="@item.StudentId" checked="@(SelectedId == item.StudentId)" disabled="@(Disabled || !item.Available)" @onchange="() => ChooseAsync(item)" /><span><strong>@item.Name</strong><span>@item.Email</span></span></label>
        }
        <div class="pagination"><span>@UiMessages.Format("EnrolmentStudentPage", students.Page, Math.Max(1, (int)Math.Ceiling(students.Total / 20d)), students.Total)</span><button type="button" disabled="@(Disabled || Busy || students.Page <= 1)" @onclick="() => LoadAsync(students.Page - 1)">@T("InstitutionPrevious")</button><button type="button" disabled="@(Disabled || Busy || students.Page * 20 >= students.Total)" @onclick="() => LoadAsync(students.Page + 1)">@T("InstitutionNext")</button></div>
    }
</section>
}

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<AcademicStudentResponse> Choose { get; set; }
    private AcademicStudentPageResponse? students;
    private string search = "", appliedSearch = "";
    private int retryPage = 1;
    protected override Task InitializeContextAsync() { students = null; search = appliedSearch = ""; return LoadAsync(1); }

    private async Task LoadAsync(int requestedPage)
    {
        if (!Active || Busy || Disabled) return;
        var context = Context;
        Busy = true; Error = null; students = null; retryPage = requestedPage;
        try {
            var result = await Api.EligibleStudentsAsync(context.CourseId, context.ClassId, requestedPage, appliedSearch, context.Token);
            if (IsCurrent(context)) students = result;
        }
        catch (Exception e) { if (IsCurrent(context)) RequestFailed(e); }
        finally { if (IsCurrent(context)) Busy = false; }
    }

    private Task SearchKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;
    private Task SearchAsync() { if (!Active || Busy || Disabled) return Task.CompletedTask; appliedSearch = search.Trim(); return LoadAsync(1); }
    private Task ChooseAsync(AcademicStudentResponse item)
        => Active && !Busy && !Disabled && item.Available && students?.Items.Contains(item) == true ? Choose.InvokeAsync(item) : Task.CompletedTask;
}
