@inherits LayoutComponentBase

<div class="site-shell">
    <a class="skip-link" href="#main-content">@UiMessages.Get("SkipToContent")</a>
    <header class="site-header">
        <span class="wordmark"><span class="brand-dot" aria-hidden="true"></span>@UiMessages.Get("Brand")</span>
        <span class="site-tag">@UiMessages.Get("PlatformTagline")</span>
    </header>
    <main id="main-content" tabindex="-1">@Body</main>
    <footer>@UiMessages.Get("Footer")</footer>
</div>
