@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IdentitySession Session
<div class="site-shell @(Session.Account is null ? "public-shell" : "workspace-shell")">
    <a class="skip-link" href="#main-content">@UiMessages.Get("SkipToContent")</a>
    @if (Session.Account is null && SchoolGether.Web.Public.PublicNavigation.View(Navigation) is "entrar" or "area")
    {
        <header class="site-header">
            <a class="wordmark" href="../"><img src="images/sagui-head.png" alt="SaguiLearn" width="64" height="64" /><span>@UiMessages.Get("Brand")</span></a>
            <AppearanceControls /><a href="../">@UiMessages.Get("PublicBack")</a>
        </header>
    }
    <main id="main-content" tabindex="-1">@Body</main>
    @if (Session.Account is null && SchoolGether.Web.Public.PublicNavigation.View(Navigation) is "entrar" or "area") { <footer>@UiMessages.Get("Footer")</footer> }
</div>
@code {
    protected override void OnInitialized() { Navigation.LocationChanged += LocationChanged; Session.Changed += SessionChanged; }
    private void SessionChanged() => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Navigation.LocationChanged -= LocationChanged; Session.Changed -= SessionChanged; }
}
