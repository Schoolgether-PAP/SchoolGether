@inherits SupportView
@inject SupportApiClient Api
<div class="support-queue-tools">
    <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label for="support-search">@T("SupportSearch")</label><input id="support-search" type="search" maxlength="150" @bind="search" @ref="searchElement" />
        <div class="support-tabs"><button type="button" aria-pressed="@(!history)" @onclick="() => TabAsync(false)">@T("SupportTickets")</button><button type="button" aria-pressed="@history" @onclick="() => TabAsync(true)">@T("SupportHistory")</button></div>
        <label for="support-state">@T("State")</label><select id="support-state" disabled="@history" @bind="status"><option value="">@T("SupportAllStates")</option>@foreach (var s in states) { <option value="@s">@Label(s)</option> }</select>
        <label for="support-priority">@T("SupportPriority")</label><select id="support-priority" @bind="priority"><option value="">@T("SupportAllPriorities")</option>@foreach (var p in priorities) { <option value="@p">@Label(p)</option> }</select>
        @if (Context.CanReadGlobal) { <details><summary>@T("SupportMoreFilters")</summary><div class="support-filter-pair"><div><label for="support-institution">@T("SupportInstitutionId")</label><input id="support-institution" type="number" min="1" @bind="institutionId" /></div><div><label for="support-assignee-filter">@T("SupportAssigneeId")</label><input id="support-assignee-filter" type="number" min="1" @bind="assigneeId" /></div></div></details> }
        <button type="submit" disabled="@Busy">@T("SupportApply")</button>
    </form>
</div>
@if (Error is not null) { <p class="support-feedback" role="alert">@Error</p><button type="button" disabled="@Busy" @onclick="RefreshAsync">@T("Retry")</button> }
@if (data is null && Busy) { <p role="status">@T("Loading")</p> }
else if (data is { } rows)
{
    <p class="support-queue-count" role="status">@UiMessages.Format("SupportResultCount", rows.Total)</p>
    <div class="support-tickets" aria-label="@T("SupportTickets")">
    @foreach (var ticket in rows.Items)
    {
        <button type="button" class="support-ticket" disabled="@SelectionLocked" aria-current="@(SelectedId == ticket.Id ? "true" : null)" @onclick="() => Selected.InvokeAsync(ticket.Id)"><small>#@ticket.Id · @Date(ticket.CreatedAt)</small><strong>@ticket.Subject</strong><span>@ticket.AuthorName</span><span class="support-ticket-bottom"><span class="support-badge">@Label(ticket.Status)</span><small>@Label(ticket.Priority)</small></span></button>
    }
    @if (rows.Items.Count == 0) { <p class="support-empty">@T("SupportNoTickets")</p> }
    </div>
    <div class="support-pagination"><button type="button" disabled="@(Busy || page == 1)" @onclick="() => PageAsync(-1)">@T("PreviousPage")</button><span>@UiMessages.Format("SupportPage", page)</span><button type="button" disabled="@(Busy || page * 20 >= rows.Total)" @onclick="() => PageAsync(1)">@T("NextPage")</button></div>
}
@code {
    [Parameter] public SupportContextResponse Context { get; set; } = default!;
    [Parameter] public bool SelectionLocked { get; set; }
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int> Selected { get; set; }
    private static readonly string[] states = ["Open", "InProgress", "AwaitingClient"], priorities = ["Low", "Normal", "High"];
    private SupportTicketPageResponse? data;
    private int page = 1;
    private int? institutionId, assigneeId;
    private bool history;
    private string search = "", status = "", priority = "";
    private ElementReference searchElement;
    protected override Task OnInitializedAsync() => RefreshAsync();
    public async Task RefreshAsync() { await RunAsync(async () => { var result = await Api.ListAsync(page, 20, Empty(search), history ? "Closed" : (Empty(status) ?? "Active"), Empty(priority), Context.CanReadGlobal ? institutionId : null, Context.CanReadGlobal ? assigneeId : null, Lifetime.Token); if (!Disposed) data = result; }); if (!Disposed) await InvokeAsync(StateHasChanged); }
    private static string? Empty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private async Task TabAsync(bool value) { history = value; page = 1; await RefreshAsync(); }
    private async Task SearchAsync() { page = 1; await RefreshAsync(); }
    private async Task PageAsync(int delta) { page += delta; await RefreshAsync(); }
    public Task FocusAsync() => searchElement.FocusAsync().AsTask();
}
