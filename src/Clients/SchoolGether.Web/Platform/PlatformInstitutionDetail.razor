@inherits PlatformView
@inject PlatformApiClient Api
<PlatformDialog Busy="saving" Title="@(detail?.Institution.Name ?? T("Institution"))" Drawer Cancel="Cancel">
    @if (mode is not null && detail is not null)
    { <h3>@T(mode == "institution-edit" ? "EditInstitution" : mode == "responsible" ? "CreateResponsible" : detail.Institution.IsSuspended ? "ReactivateInstitution" : "SuspendInstitution")</h3><PlatformMutationForm BusyChanged="value => saving = value" @key="mode" Context="Context" PermissionsChanged="PermissionsChanged" Kind="@mode" Institution="detail.Institution" Saved="Saved" Cancel="Cancel" /> }
    else if (!Can(PlatformPermissions.InstitutionsRead)) { <p role="alert" class="feedback error-message">@T("PlatformForbidden")</p> }
    else if (Error is not null) { <p class="feedback error-message" role="alert">@Error</p><button type="button" disabled="@Busy" @onclick="LoadAsync">@T("Retry")</button> }
    else if (detail is null) { <p role="status">@T("Loading")</p> }
    else
    {
        <div class="detail-tabs"><button type="button" aria-pressed="@(tab == "summary")" @onclick='() => tab = "summary"'>@T("Summary")</button><button type="button" aria-pressed="@(tab == "people")" @onclick='() => tab = "people"'>@T("Responsibles")</button>@if (Can(PlatformPermissions.AuditRead)) { <button type="button" aria-pressed="@(tab == "history")" @onclick='() => tab = "history"'>@T("History")</button> }</div>
        @if (tab == "history" && Can(PlatformPermissions.AuditRead)) { <PlatformAudit Context="Context" PermissionsChanged="PermissionsChanged" InstitutionId="Id" /> }
        else if (tab == "people")
        { @if (detail.Administrators.Count == 0) { <p>@T("ResponsiblesEmpty")</p> }@foreach (var admin in detail.Administrators) { <div class="responsible"><strong>@admin.Name</strong><p>@admin.Email</p></div> } }
        else
        {
            <dl class="record-fields"><div><dt>@T("Institution")</dt><dd>@detail.Institution.Name (#@detail.Institution.Id)</dd></div><div><dt>@T("State")</dt><dd>@T(detail.Institution.IsSuspended ? "Suspended" : "Active")</dd></div><div><dt>@T("CreatedUtc")</dt><dd>@detail.Institution.CreatedAt.ToUniversalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>@T("Accounts")</dt><dd>@detail.Institution.AccountsCount</dd></div>@if (detail.Institution.SuspensionReason is { } reason) { <div><dt>@T("Reason")</dt><dd>@reason</dd></div> }</dl>
        }
        <div class="context-actions">@if (Can(PlatformPermissions.InstitutionsWrite)) { <button type="button" @onclick='() => mode = "institution-edit"'>@T("EditInstitution")</button><button type="button" @onclick='() => mode = "responsible"'>@T("CreateResponsible")</button> }@if (Can(PlatformPermissions.InstitutionsSuspend)) { <button type="button" @onclick='() => mode = "suspension"'>@T(detail.Institution.IsSuspended ? "ReactivateInstitution" : "SuspendInstitution")</button> }</div>
    }
</PlatformDialog>
@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public EventCallback Saved { get; set; }
    private PlatformInstitutionDetailResponse? detail;
    private string tab = "summary";
    private string? mode;
    private bool saving;
    protected override Task OnInitializedAsync() => LoadAsync();
    private Task LoadAsync() => RunAsync(token => Api.GetInstitutionAsync(Id, token), value => detail = value);
}
