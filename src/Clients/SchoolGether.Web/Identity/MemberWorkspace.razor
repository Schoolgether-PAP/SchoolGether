@inject SchoolGether.Web.Learning.PendingLearningCreation<SchoolGether.Contracts.Learning.CreateLessonPlanRequest> PendingPlans
@inject SchoolGether.Web.Learning.PendingLearningCreation<SchoolGether.Contracts.Learning.CreateLearningMaterialRequest> PendingMaterials
<NavigationLock ConfirmExternalNavigation="@HasPendingCreation" OnBeforeInternalNavigation="BeforeNavigation" />
<div class="member-shell" @onkeydown="HandleKeyAsync">
    <header class="member-header"><a class="workspace-brand" href="../"><img src="images/sagui-head.png" alt="SaguiLearn" /><strong>@T("Brand")</strong></a><div class="workspace-breadcrumb"><span>@T(Account.Role == "Teacher" ? "RoleTeacher" : "RoleStudent")</span><span aria-hidden="true">/</span><strong>@T(SectionTitle)</strong></div><AppearanceControls Sidebar /><button class="member-menu-toggle" type="button" aria-expanded="@(menu ? "true" : "false")" aria-controls="member-navigation" @ref="menuToggle" @onclick="() => menu = !menu">@T("Menu")</button></header>
    <aside class="member-sidebar @(menu ? "menu-open" : "")" id="member-navigation">
        <nav aria-label="@T("AccountWorkspace")">
            @foreach(var item in Areas){<button type="button" title="@T(item.Title)" aria-current="@(section==item.Id ? "page" : null)" @onclick="()=>Navigate(item.Id)"><WorkspaceIcon Name="@item.Icon" /><span>@T(item.Title)</span></button>}
        </nav>
        <div class="workspace-account"><span class="account-avatar" aria-hidden="true">@Initial</span><div><strong>@Account.Name</strong><span>@T(Account.Role == "Teacher" ? "RoleTeacher" : "RoleStudent")</span></div><button type="button" disabled="@Busy" aria-label="@T("SignOut")" title="@T("SignOut")" @onclick="SignOut"><WorkspaceIcon Name="Exit" /></button></div>
        <a class="workspace-return" href="../"><WorkspaceIcon Name="External" />@T("PublicBack")</a>
    </aside>
    <section class="member-content" aria-busy="@(Busy ? "true" : "false")">
        @if (navigationBlocked && HasPendingCreation) { <p role="alert">@SchoolGether.Web.Learning.LearningMaterialMessages.Get("Pending")</p> }
        @if(section=="classes"){<SchoolGether.Web.Learning.ClassroomOverview @key="Account.Id" />}
        else if(section=="plans" && Account.Role=="Teacher"){<SchoolGether.Web.Learning.LessonPlans @key="Account.Id" />}
        else if(section=="materials"){<SchoolGether.Web.Learning.TeachingMaterials @key="Account.Id" />}
        else if (section=="calendar") { <SchoolGether.Web.Calendar.SchoolCalendar @key="Account.Id" /> }
        else if (section=="support" && Account.Role == "Teacher") { <SchoolGether.Web.Support.SupportWorkspace @key="Account.Id" /> }
        else
        {
            <div class="page-heading"><div><h1 tabindex="-1" @ref="heading">@T("ProfileTitle")</h1><p class="platform-intro">@T("MemberWorkspaceHelp")</p></div><button type="button" disabled="@Busy" @onclick="Refresh">@T(Busy ? "RefreshingProfile" : "RefreshProfile")</button></div>
            <section class="member-profile" aria-labelledby="member-name"><div class="member-profile-title"><span class="account-avatar" aria-hidden="true">@Initial</span><div><h2 id="member-name">@Account.Name</h2><p>@T(Account.Role == "Teacher" ? "RoleTeacher" : "RoleStudent")</p></div></div><dl class="profile-details"><div><dt>@T("Email")</dt><dd>@Account.Email</dd></div><div><dt>@T("Institution")</dt><dd>@(Account.InstitutionId is { } id ? UiMessages.Format("InstitutionNumber", id) : T("InstitutionUnavailable"))</dd></div></dl></section>
        }
        @if (Feedback is not null) { <p class="feedback @(IsError ? "error-message" : "status-message")" role="@(IsError ? "alert" : "status")">@Feedback</p> }
    </section>
</div>
@code {
    [Parameter, EditorRequired] public AccountResponse Account { get; set; } = default!;
    [Parameter] public EventCallback SignOut { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Feedback { get; set; }
    [Parameter] public bool IsError { get; set; }
    private string section="classes";
    private bool HasPendingCreation => PendingPlans.Request is not null || PendingMaterials.Request is not null;
    private bool navigationBlocked;
    private void BeforeNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context) { if (HasPendingCreation) { context.PreventNavigation(); navigationBlocked = true; } }
    private bool menu, focus;
    private IEnumerable<(string Id,string Title,string Icon)> Areas {
        get {
            yield return ("classes","MemberClasses","Learning");
            if(Account.Role=="Teacher")yield return ("plans","LessonPlans","Courses");
            yield return ("materials","TeachingMaterials","Courses");
            yield return ("calendar","Calendar","Calendar");
            if(Account.Role=="Teacher")yield return ("support","Support","Support");
            yield return ("profile","ProfileTitle","Profile");
        }
    }
    private string SectionTitle=>Areas.FirstOrDefault(x=>x.Id==section).Title??"MemberClasses";
    private ElementReference heading, menuToggle;
    private string Initial => Account.Name.Trim().FirstOrDefault().ToString().ToUpperInvariant();
    private static string T(string key) => UiMessages.Get(key);
    private void Navigate(string value) { if(!Areas.Any(x=>x.Id==value))return;section=value;menu=false;focus=value=="profile"; }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (focus && section=="profile") { focus = false; await heading.FocusAsync(); } }
    private async Task HandleKeyAsync(KeyboardEventArgs e) { if (e.Key == "Escape" && menu) { menu = false; await menuToggle.FocusAsync(); } }
}
