<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SchoolGether.Mobile"
             xmlns:identity="clr-namespace:SchoolGether.Mobile.Identity"
             x:Class="SchoolGether.Mobile.MainPage" x:DataType="identity:IdentityViewModel"
             Title="{x:Static local:UiMessages.Brand}" BackgroundColor="{StaticResource IdentityBackground}">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource IdentityText}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource IdentityText}" />
            <Setter Property="BackgroundColor" Value="{StaticResource IdentityBackground}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource IdentityText}" />
                                <Setter Property="BorderColor" Value="{StaticResource IdentityText}" />
                                <Setter Property="BorderWidth" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                <Setter Property="TextColor" Value="{StaticResource IdentityText}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <Grid x:Name="IdentityLayout" Padding="24" RowDefinitions="Auto,Auto" ColumnDefinitions="*"
              RowSpacing="24" ColumnSpacing="48" MaximumWidthRequest="1100" HorizontalOptions="Fill"
              VerticalOptions="Center" SizeChanged="OnLayoutSizeChanged">
            <VerticalStackLayout x:Name="BrandPanel" Spacing="16" VerticalOptions="Center">
                <Image Source="schoolgether_logo.jpeg" HeightRequest="220" WidthRequest="220" Aspect="AspectFit"
                       HorizontalOptions="Center" SemanticProperties.Description="{x:Static local:UiMessages.LogoDescription}" />
                <Label Text="{x:Static local:UiMessages.Brand}" FontSize="30" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level1" />
                <BoxView HeightRequest="4" WidthRequest="48" HorizontalOptions="Start" Color="{StaticResource Tertiary}" />
                <Label Text="{x:Static local:UiMessages.Welcome}" FontSize="24" FontFamily="OpenSansSemibold" />
                <Label Text="{x:Static local:UiMessages.Intro}" TextColor="{StaticResource IdentityMuted}" />
            </VerticalStackLayout>
            <Border x:Name="FormPanel" Grid.Row="1" Padding="24" BackgroundColor="White" Stroke="{StaticResource Secondary}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsLoginVisible}">
                        <Label Text="{x:Static local:UiMessages.LoginTitle}" FontSize="26" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{x:Static local:UiMessages.LoginSubtitle}" TextColor="{StaticResource IdentityMuted}" />
                        <Label Text="{x:Static local:UiMessages.Email}" />
                        <Entry Text="{Binding Email}" Keyboard="Email" MaxLength="256" ReturnType="Next" IsEnabled="{Binding CanInteract}"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="{x:Static local:UiMessages.Email}" />
                        <Label Text="{x:Static local:UiMessages.Password}" />
                        <Entry Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" MaxLength="128" ReturnType="Go"
                               Completed="OnPasswordCompleted" IsEnabled="{Binding CanInteract}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                               SemanticProperties.Description="{x:Static local:UiMessages.Password}" />
                        <Button Text="{Binding PasswordToggleText}" Command="{Binding TogglePasswordCommand}" IsEnabled="{Binding CanInteract}"
                                SemanticProperties.Description="{Binding PasswordToggleText}" />
                        <Button Text="{x:Static local:UiMessages.SignIn}" Command="{Binding LoginCommand}" SemanticProperties.Description="{x:Static local:UiMessages.SignIn}" />
                        <Label Text="{x:Static local:UiMessages.AccountHelp}" TextColor="{StaticResource IdentityMuted}" FontSize="14" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsAuthenticated}">
                        <Label Text="{x:Static local:UiMessages.ProfileTitle}" FontSize="26" FontFamily="OpenSansSemibold" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{x:Static local:UiMessages.ProfileSubtitle}" TextColor="{StaticResource IdentityMuted}" />
                        <Label Text="{x:Static local:UiMessages.Name}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Account.Name}" />
                        <Label Text="{x:Static local:UiMessages.Email}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Account.Email}" />
                        <Label Text="{x:Static local:UiMessages.Role}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding RoleText}" />
                        <Label Text="{x:Static local:UiMessages.Institution}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding InstitutionText}" />
                        <Button Text="{x:Static local:UiMessages.RefreshProfile}" Command="{Binding RefreshProfileCommand}" SemanticProperties.Description="{x:Static local:UiMessages.RefreshProfile}" />
                        <Button Text="{x:Static local:UiMessages.SignOut}" Command="{Binding LogoutCommand}" SemanticProperties.Description="{x:Static local:UiMessages.SignOut}" />
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
                    <Label Text="{x:Static local:UiMessages.Busy}" IsVisible="{Binding IsBusy}" />
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="{StaticResource IdentityError}" />
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" />
                    <Button Text="{x:Static local:UiMessages.RetryRestore}" Command="{Binding RestoreCommand}" IsVisible="{Binding CanRetryRestore}" SemanticProperties.Description="{x:Static local:UiMessages.RetryRestore}" />
                    <Button Text="{x:Static local:UiMessages.SignOut}" Command="{Binding LogoutCommand}" IsVisible="{Binding CanRetryLogout}" SemanticProperties.Description="{x:Static local:UiMessages.SignOut}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
